{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://langbackend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://langbackend-production.up.railway.app/politica-de-privacidade/"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://langbackend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://langbackend-production.up.railway.app/politica-de-privacidade/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://langbackend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://langbackend-production.up.railway.app/politica-de-privacidade/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
