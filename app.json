{
  "expo": {
    "name": "Lang",
    "slug": "lang-login",
    "scheme": [
      "lang",
      "com.rafael.lang"
    ],
    "android": {
      "package": "com.rafael.lang"
    },
    "ios": {
      "bundleIdentifier": "com.rafael.lang"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f4efe6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-web-browser",
      "expo-asset",
      "expo-audio",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o Lang use o microfone para exercicios de fala.",
          "speechRecognitionPermission": "Permita que o Lang reconheca sua fala nos exercicios.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Este identificador será usado para oferecer anúncios mais relevantes."
        }
      ]
    ],
    "extra": {
      "googleAuth": {
        "androidClientId": "46582084112-4v43hbjpnigq5d0qeod0olsdh8mleas8.apps.googleusercontent.com",
        "iosClientId": "46582084112-5abjvbbbrfubi6otkkmg2cvm4kcf3k46.apps.googleusercontent.com",
        "webClientId": "46582084112-mp2tu185jebr279c5sjq91u6kdpekkcu.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "2fb41043-3f09-43fe-bee4-5ed593f201f1"
      }
    }
  }
}
